{
  "base": "http://127.0.0.1:8787/api",
  "note": "Console and OpenClaw talk to this only. OpenClaw never gets a Mongo URI. Poll GET /events and GET /alerts every 1s.",
  "endpoints": [
    {"method": "GET", "path": "/events", "who": "console", "does": "log stream"},
    {"method": "GET", "path": "/orders", "who": "console+agent", "does": "each object + quantities"},
    {"method": "GET", "path": "/papers", "who": "console", "does": "on-file PO/BOL vs packing slip the worker sees"},
    {"method": "GET", "path": "/orders/:id", "who": "console", "does": "one object + papers + voice + alerts"},
    {"method": "GET", "path": "/alerts", "who": "console", "does": "poll red alerts"},
    {"method": "POST", "path": "/orders/:id/flag", "who": "supervisor UI", "does": "mark invalid"},
    {"method": "POST", "path": "/investigate", "who": "search pane", "does": "Qwen forensics"},
    {"method": "GET", "path": "/investigations/:id", "who": "search pane", "does": "citation trail"},
    {"method": "POST", "path": "/audio", "who": "laptop mic or wav upload", "does": "Whisper STT then same matcher as /voice-events"},
    {"method": "POST", "path": "/voice-events", "who": "OpenClaw", "does": "transcript in, matcher writes Mongo"},
    {"method": "POST", "path": "/clarifications/:id/answer", "who": "OpenClaw", "does": "confirm -> alert, correct -> commit"},
    {"method": "GET", "path": "/work", "who": "OpenClaw heartbeat", "does": "open clarifications + alerts without Mongo"},
    {"method": "POST", "path": "/heartbeat", "who": "OpenClaw cron", "does": "stale flags + shift log"},
    {"method": "GET", "path": "/shift-logs", "who": "console logs", "does": "hourly item/qty vectors"}
  ]
}
